# Choose either openai_compatible or dify.
LLM_PROVIDER=openai_compatible

# OpenAI-compatible provider
BAILIAN_API_KEY=replace_with_api_key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-turbo

# Dify Chatflow provider (used only when LLM_PROVIDER=dify)
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_USER=soc-audit-local
